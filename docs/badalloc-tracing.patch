+// DBG: log large allocations to help track down bad_alloc
+void* operator new(std::size_t dbg_n) {
+    if (dbg_n > (128ULL << 20))
+        fprintf(stderr, "DBG new BIG: %zu bytes (%.2f GiB)\n", dbg_n, (double)dbg_n / 1073741824.0);
+    void* dbg_p = std::malloc(dbg_n ? dbg_n : 1);
+    if (!dbg_p) throw std::bad_alloc();
+    return dbg_p;
+}
+void operator delete(void* dbg_p) noexcept { std::free(dbg_p); }
+void operator delete(void* dbg_p, std::size_t) noexcept { std::free(dbg_p); }
+void* operator new[](std::size_t dbg_n) { return operator new(dbg_n); }
+void operator delete[](void* dbg_p) noexcept { std::free(dbg_p); }
+void operator delete[](void* dbg_p, std::size_t) noexcept { std::free(dbg_p); }
 
